{
    "blocks": [
        "minecraft:acacia_sign", "minecraft:bamboo_sign", "minecraft:birch_sign",
        "minecraft:cherry_sign", "minecraft:crimson_sign", "minecraft:dark_oak_sign",
        "minecraft:jungle_sign", "minecraft:mangrove_sign", "minecraft:oak_sign",
        "minecraft:spruce_sign", "minecraft:warped_sign", "minecraft:pale_oak_sign",

        "minecraft:acacia_wall_sign", "minecraft:bamboo_wall_sign", "minecraft:birch_wall_sign",
        "minecraft:cherry_wall_sign", "minecraft:crimson_wall_sign", "minecraft:dark_oak_wall_sign",
        "minecraft:jungle_wall_sign", "minecraft:mangrove_wall_sign", "minecraft:oak_wall_sign",
        "minecraft:spruce_wall_sign", "minecraft:warped_wall_sign", "pale_oak_wall_sign"
    ],
    "defaultTexture": "minecraft:block/oak_planks",
    "handler": [
        {
            "variables": [
                "type = thisBlock.name.substring(thisBlock.name.indexOf(':') + 1)",
                "rotY = thisBlock.state.rotation != null ? (22.5 * thisBlock.state.rotation) : 0.0",
                "isWall = false",
                "scale = 16.0 / 24.0",
                "offsetX = 8.0",
                "offsetY = 0.0",
                "offsetZ = 8.0",
                "rotModelI = thisBlock.state.rotation != null ? (0 + thisBlock.state.rotation) : 0",
                "rotModelI = rotModelI > 3 ? (rotModelI - 4) : rotModelI",
                "rotModelI = rotModelI > 3 ? (rotModelI - 4) : rotModelI",
                "rotModelI = rotModelI > 3 ? (rotModelI - 4) : rotModelI",
                "rotModelI = rotModelI > 3 ? (rotModelI - 4) : rotModelI",
                "rotYModel = 0",
                "rotYModel = rotY > 80 ? 90 : rotYModel",
                "rotYModel = rotY > 170 ? 180 : rotYModel",
                "rotYModel = rotY > 260 ? 270 : rotYModel",
                "modelName = 'minecraft:block/' + type + '_rot_' + rotModelI"
            ]
        },
        {
            "condition": "thisBlock.name.endsWith('_wall_sign')",
            "variables": [
                "rotY = 0",
                "rotY = thisBlock.state.facing == 'north' ? 180.0 : rotY",
                "rotY = thisBlock.state.facing == 'east' ? 270.0 : rotY",
                "rotY = thisBlock.state.facing == 'south' ? 0.0 : rotY",
                "rotY = thisBlock.state.facing == 'west' ? 90.0 : rotY",
                "isWall = true",
                "offsetX = 8.0",
                "offsetY = 8.333333",
                "offsetZ = 1.0",
                "rotYModel = rotY",
                "modelName = 'minecraft:block/' + type"
            ]
        },
        {
            "transform": {
                "rotate": [ 0.0, "rotYModel", 0.0 ]
            },
            "generators": [
                {
                    "type": "model",
                    "args": {
                        "model": "modelName"
                    }
                }
            ]
        },
        {
            "transform": {
                "rotate": [ 0.0, "rotY", 0.0 ]
            },
            "generators": [
                {
                    "type": "signText",
                    "args": {
                        "state": "thisBlock.state",
                        "textOffsetX": "offsetX",
                        "textOffsetY": "(isWall ? 0.0 : 20.0) * scale + offsetY + 0.133",
                        "textOffsetZ": "1.0 * scale + offsetZ + 0.02",
                        "textOffsetZBack": "-1.0 * scale + offsetZ - 0.02",
                        "textScale": "6.666 / 5.0",
                        "lineDistance": "2.5 * scale"
                    }
                }
            ]
        }
    ]
}
